            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="  username, password &lt;&lt;&lt; JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Random

def randomString(int length) {
    def pool = (&apos;A&apos;..&apos;Z&apos;) + (&apos;a&apos;..&apos;z&apos;) + (&apos;0&apos;..&apos;9&apos;)
    def random = new Random()
    def builder = new StringBuilder()

    length.times {
        builder.append(pool[random.nextInt(pool.size())])
    }

    return builder.toString()
}

String username_value = randomString(12);
String password_value = randomString(12);

vars.put(&quot;username&quot;, username_value);
vars.put(&quot;password&quot;, password_value);

</stringProp>
              <stringProp name="TestPlan.comments">создаем переменные username и password</stringProp>
            </JSR223PreProcessor>
