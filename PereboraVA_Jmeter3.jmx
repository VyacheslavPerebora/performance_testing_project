            <hashTree/>
            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="random_ticket_id &lt;&lt;&lt; REE" enabled="true">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">random_ticket_id</stringProp>
              <stringProp name="RegexExtractor.regex">ticket.+?(\d+).*?\[</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">ERR_random_ticket_id</stringProp>
              <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
              <stringProp name="RegexExtractor.match_number">0</stringProp>
              <stringProp name="TestPlan.comments">извлекаем из тела ответа случайный параметр пути /ticket_id/ для последующего открытия деталей задачи (тикета)</stringProp>
            </RegexExtractor>
