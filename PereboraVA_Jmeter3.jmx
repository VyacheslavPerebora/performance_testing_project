            <boolProp name="IfController.useExpression">true</boolProp>
            <stringProp name="TestPlan.comments">проверяем условие, что задача не назначена ни на кого (Unassigned) и во внутреннем запросе назначаем ее на user под которым мы авторизовались</stringProp>
          </IfController>
