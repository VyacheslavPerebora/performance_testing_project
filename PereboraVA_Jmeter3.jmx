              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def sortx_1 = &quot;Created&quot;
def sortx_2 = &quot;Title&quot;
def sortx_3 = &quot;Queue&quot;
def sortx_4 = &quot;Status&quot;
def sortx_5 = &quot;Priority&quot;
def sortx_6 = &quot;Owner&quot;

def sortxList = [sortx_1, sortx_2, sortx_3, sortx_4, sortx_5, sortx_6]



int n = ${__Random(1,2,)};
int randomIndex = ${__Random(0,5,)};
int status_value = ${__Random(1,5,)};

if (n == 1) { vars.put(&quot;filter_name&quot;, &quot;sortx&quot;); vars.put(&quot;filter_value&quot;, sortxList[randomIndex]); } 

else { vars.put(&quot;filter_name&quot;, &quot;status&quot;); vars.put(&quot;filter_value&quot;, &quot;${status_value}&quot;); } </stringProp>
            </JSR223PreProcessor>
