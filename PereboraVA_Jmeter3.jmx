            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor username, password &gt;&gt;&gt; users.csv" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">FileWriter fWriter = new FileWriter(&quot;users.csv&quot;, true);

String username = vars.get(&quot;username&quot;);
String password = vars.get(&quot;password&quot;)


String line_1 = &quot;${username}&quot; + &quot;,&quot; + &quot;${password}&quot; + &quot;\n&quot;;
fWriter.write(line_1);

fWriter.close();</stringProp>
              <stringProp name="TestPlan.comments">создаем файл users.csv и записываем в него (дописываем, если файл создан) username и password пользователя</stringProp>
