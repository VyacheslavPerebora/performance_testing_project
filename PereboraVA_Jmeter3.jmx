            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="records_Total &lt;&lt;&lt; REE" enabled="true">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">records_Total</stringProp>
              <stringProp name="RegexExtractor.regex">recordsTotal.+?(\d+),</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">ERR_recordsTotal</stringProp>
              <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
              <stringProp name="RegexExtractor.match_number">1</stringProp>
              <stringProp name="TestPlan.comments">извлекаем из тела ответа значение records_Total (общее количество созданных тикетов)</stringProp>
            </RegexExtractor>
            <hashTree/>
            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="check_updated_list_tickets &lt;&lt;&lt; REE">
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">check_updated_list_tickets</stringProp>
              <stringProp name="RegexExtractor.regex">data.*?ticket.*?\[(.+?)\]</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">ERR_check_updated_list_tickets</stringProp>
              <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
              <stringProp name="RegexExtractor.match_number">1</stringProp>
              <stringProp name="TestPlan.comments">извлекаем из ответа номер 1-го тикета (используем значение этой переменной в ответе на следующий запрос для проверки того, что данные в списке тикетов обновились )</stringProp>
            </RegexExtractor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="start &lt;&lt;&lt; JSR223 PostProcessor">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Random

Random random = new Random()


int r_T = Integer.parseInt(vars.get(&quot;records_Total&quot;));
int a = 10;
int b = Math.floorDiv(r_T, a); 


if (r_T &gt; 10){
//random.nextInt(b) создаст псевдослучайное число от 0 включительно, до b исключительно
if ((r_T - a * b) &gt; 0) { int r = random.nextInt(b) + 1; int start = r * 10; vars.put(&quot;start&quot;, &quot;${start}&quot;); } 

else {int b_ = b - 1; int r = random.nextInt(b_) + 1; int start = r * 10; vars.put(&quot;start&quot;, &quot;${start}&quot;); }
             }
</stringProp>
              <stringProp name="TestPlan.comments">рассчитываем параметр start для перехода на случайную страницу из списка тикетов</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
